{
  "manifest_version": 3,
  "name": "ErrorGeek: Windows Error Code Lookup",
  "short_name": "ErrorGeek",
  "version": "1.0.0",
  "description": "Look up any Windows error code offline: HRESULT, Win32, NTSTATUS and Windows Update codes, with names, meanings and links.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Look up a Windows error code",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://techygeekshome.info/browser-extensions/errorgeek/",
  "browser_specific_settings": {
    "gecko": {
      "id": "errorgeek@techygeekshome.info",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}